# ─── WhatsApp Cloud API (Meta directo, sin BSP) ──────────────────────────────
# App secret de la app de Meta. Se usa para verificar el HMAC del webhook.
WA_APP_SECRET=
# Token que tú inventas; Meta lo devuelve en el handshake GET /webhook.
WA_VERIFY_TOKEN=
# System User token permanente. El token de desarrollador expira en 24h.
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
# Fijar la versión. Nunca "latest": Meta introduce cambios incompatibles.
WA_GRAPH_VERSION=v23.0

# ─── Modelo ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# gpt-5.6-terra ($2/$12 por MTok) es el balance por defecto.
# gpt-5.6-sol ($5/$30) si la fase transaccional lo necesita.
AGENT_MODEL=openai:gpt-5.6-terra

# ─── Datos (Postgres propio de ventupilot, NO la BD de Saleor) ───────────────
DATABASE_URL=

# ─── Saleor (proyecto Railway separado, alcanzable solo por HTTPS público) ───
SALEOR_GRAPHQL_URL=
# App token con permisos mínimos: leer productos + manejar checkouts.
SALEOR_APP_TOKEN=
# Slug del canal que define qué precios ve el agente.
SALEOR_CHANNEL_SLUG=
SALEOR_TIMEOUT_SECONDS=5.0

# ─── Identidad ───────────────────────────────────────────────────────────────
# Pepper para el HMAC de números de teléfono. Un SHA256 pelado de un número
# chileno de 9 dígitos se rompe por fuerza bruta en segundos; el pepper lo evita.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# Rotarlo invalida todos los wa_id_hash existentes.
WA_ID_PEPPER=

# ─── Límites ─────────────────────────────────────────────────────────────────
MAX_REQUESTS_PER_RUN=6
MAX_TOOL_CALLS_PER_RUN=12
PROPUESTA_TTL_MIN=30

# ─── Entorno ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
