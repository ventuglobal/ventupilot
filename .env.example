# ─── Transporte de WhatsApp ──────────────────────────────────────────────────
# meta  → Cloud API directa de Meta.
# kapso → Kapso como proveedor. Es un proxy compatible con Meta: el cuerpo de
#         los mensajes es idéntico, así que cambiar de uno a otro no toca el
#         agente ni el render de las cotizaciones, solo URL y cabeceras.
WA_TRANSPORTE=meta

# ─── Kapso (solo si WA_TRANSPORTE=kapso) ─────────────────────────────────────
# Clave de proyecto. Autentica el envío en la cabecera X-API-Key.
KAPSO_API_KEY=
KAPSO_BASE_URL=https://api.kapso.ai
# Secreto del webhook, el que se pasó en `kapso whatsapp webhooks new
# --secret-key`. Kapso firma con HMAC-SHA256 sobre el cuerpo crudo y lo manda
# en X-Webhook-Signature, en hex PELADO — sin el prefijo `sha256=` de Meta.
# Confundir las dos cabeceras da un 403 permanente que parece un secreto mal
# copiado.
KAPSO_WEBHOOK_SECRET=

# Crear el webhook con --kind meta: así Kapso reenvía el payload de Meta sin
# modificar y el parser de payloads sigue sirviendo tal cual.

# ─── WhatsApp Cloud API (solo si WA_TRANSPORTE=meta) ─────────────────────────
# App secret de la app de Meta. Verifica el HMAC del webhook.
WA_APP_SECRET=
# Token que tú inventas. Meta lo devuelve en el handshake GET /webhook y tiene
# que coincidir exactamente. No necesita ser un secreto fuerte, pero sí estable.
WA_VERIFY_TOKEN=
# System User token, permanente. El token de desarrollador expira en 24h: si la
# integración deja de funcionar al día siguiente, es esto.
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
# Fijada a propósito. "latest" cambia bajo los pies sin aviso.
WA_GRAPH_VERSION=v23.0

# ─── Modelo ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# gpt-5.6-terra ($2/$12 por MTok) es el balance por defecto.
# gpt-5.6-sol ($5/$30) si la fase transaccional lo necesita.
AGENT_MODEL=openai:gpt-5.6-terra

# ─── Datos ───────────────────────────────────────────────────────────────────
# Postgres de ventu 1.0, por red privada de Railway. El agente escribe solo en
# el esquema `ventupilot`; nada suyo toca las tablas de la aplicación.
# En Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Rol de SOLO LECTURA sobre el catálogo de productos, separado del anterior.
# Es lo que hace que un prompt injection no tenga privilegio que escalar:
#
#   CREATE ROLE ventupilot_ro LOGIN PASSWORD '...';
#   GRANT USAGE ON SCHEMA public TO ventupilot_ro;
#   GRANT SELECT ON <tablas o vistas de catálogo> TO ventupilot_ro;
#
# Concede SELECT tabla por tabla. Un GRANT sobre ALL TABLES vuelve a abrir todo.
DATABASE_URL_RO=

# Techo explícito de conexiones. Con varias réplicas es fácil agotar
# max_connections, y el que se cae entonces es ventu 1.0, no el agente.
DB_POOL_MIN=1
DB_POOL_MAX=5

# ─── Identidad ───────────────────────────────────────────────────────────────
# Pepper para el HMAC de los números. Un SHA256 pelado de un móvil chileno son
# 10^8 candidatos: una GPU lo revierte en segundos.
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
# Rotarlo invalida todos los wa_id_hash almacenados: es parte del esquema.
WA_ID_PEPPER=

# Altas de remitentes, aplicadas por el worker al arrancar (invariante 4).
# `ventupilot.clientes` arranca vacía y nadie se auto-registra: hasta que
# alguien figure aquí, todo el mundo recibe "no autorizado".
#
#   CLIENTES_AUTORIZADOS="+56 9 6626 6451:consultar,cotizar; 56900000000:consultar"
#
# Permisos: consultar | cotizar | pedir. Sin permisos se concede solo
# `consultar` — el defecto es el mínimo, nunca el máximo.
#
# Quitar a alguien de aquí NO lo revoca: revocar es explícito, para que un
# despliegue con la variable mal copiada no corte accesos en silencio.
CLIENTES_AUTORIZADOS=

# Acceso abierto: cualquiera que escriba puede usar el agente sin figurar en
# `ventupilot.clientes`. Tres costes que conviene tener presentes:
#   - Cualquiera que dé con el número consume tokens y mensajes de WhatsApp.
#     No hay tope por remitente, solo por run.
#   - Se pierde la trazabilidad: no hay customer_id que enlace la propuesta
#     con un cliente de ventu 1.0.
#   - No pisa una desactivación: quien esté registrado como inactivo sigue
#     fuera, porque desactivar es deliberado y esto no debe anularlo.
ACCESO_ABIERTO=false
# Qué se concede en acceso abierto. `pedir` fuera del defecto a propósito:
# es el permiso con impacto económico directo.
PERMISOS_ABIERTOS=consultar,cotizar

# ─── Precios ─────────────────────────────────────────────────────────────────
# De dónde sale el precio que se cotiza:
#   motor → pricing_productpriceresult.precio_final, la salida del motor de
#           precios de ventu 1.0 (costo, markup, IVA, campañas, por canal).
#   costo → costo bruto del producto x PRECIO_FACTOR.
# En ambos casos lo calcula el backend, nunca el modelo (invariante 1).
PRECIO_ORIGEN=motor

# Multiplicador sobre el costo cuando PRECIO_ORIGEN=costo.
PRECIO_FACTOR=1.4

# Qué costo se toma como base.
#   credito → costo_credito (D3, web LK). Es el BRUTO, y el que usa el propio
#             motor de ventu 1.0 en marketplace_price.
#   contado → costo_contado (D4), que ventu 1.0 etiqueta como NETO. Con el
#             mismo factor da un precio sistemáticamente más bajo: no son
#             bases intercambiables.
PRECIO_COSTO=credito

# Canal del motor de precios. Solo se usa con PRECIO_ORIGEN=motor.
# Valores válidos: global | ml | shopify. Ojo: `global` no tiene filas de
# resultado —solo políticas— y cada canal se recalcula a su propio ritmo.
PRICING_CHANNEL=shopify

# Un precio recalculado hace más de esto no se considera vigente y el producto
# no se ofrece. Ojo: si el motor de precios de ventu 1.0 deja de correr, esto
# vacía el catálogo ofrecible en silencio — el agente dirá que no hay nada.
PRECIO_MAX_EDAD_HORAS=48

# ─── Límites ─────────────────────────────────────────────────────────────────
MAX_REQUESTS_PER_RUN=6
MAX_TOOL_CALLS_PER_RUN=12
MAX_RESULTADOS_BUSQUEDA=8
PROPUESTA_TTL_MIN=30

LOG_LEVEL=INFO

# ─── prisa.cl (portal B2B del proveedor) ─────────────────────────────────────
# Login con navegador: el formulario lleva un reCAPTCHA v2 invisible y su token
# solo lo genera JavaScript. Ver PRISA.md.
#
# Usuario: RUT con guion y dígito verificador, o correo. El formulario acepta
# ambos.
PRISA_USUARIO=
PRISA_PASSWORD=

# Dónde se guardan las cookies de la sesión. El fichero se crea con permisos
# 0600: mientras duran, esas cookies valen lo mismo que la contraseña.
PRISA_SESION_PATH=.prisa-sesion.json

# Proxy de salida para el navegador. Vacío = conexión directa, que es lo que
# funciona hoy. Se usa si el reCAPTCHA empieza a levantar retos: eso depende de
# la reputación de la IP, y la respuesta es una IP residencial chilena (Apify,
# por ejemplo), no un cambio de código.
PRISA_PROXY=
